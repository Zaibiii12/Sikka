{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:live": "RUN_LIVE_PAYMENT_E2E=1 playwright test tests/e2e/live-payment.spec.ts --workers=1",
    "e2e:all": "RUN_LIVE_PAYMENT_E2E=1 RUN_LIVE_SECURITY_E2E=1 playwright test --workers=1",
    "e2e:security": "RUN_LIVE_SECURITY_E2E=1 playwright test tests/e2e/security-payment.spec.ts --workers=1",
    "recovery:indexer:send": "node scripts/indexer-outage-payment.mjs",
    "recovery:indexer:verify": "node scripts/indexer-recovery-verify.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
