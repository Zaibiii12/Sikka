

# ---------------------------------------------------------
# API authentication / RBAC
# ---------------------------------------------------------
# Generate real local values in backend/.env.
# Never commit operational bearer tokens.

BLOCKSIKKA_AUTH_REQUIRED=true
BLOCKSIKKA_AUTH_VIEWER_TOKEN=replace-with-random-secret
BLOCKSIKKA_AUTH_PAYMENT_OPERATOR_TOKEN=replace-with-random-secret
BLOCKSIKKA_AUTH_BANK_OPERATOR_TOKEN=replace-with-random-secret
BLOCKSIKKA_AUTH_TREASURY_OPERATOR_TOKEN=replace-with-random-secret
BLOCKSIKKA_AUTH_TREASURY_ADMIN_TOKEN=replace-with-random-secret
