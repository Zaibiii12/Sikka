APP_NAME=BlockSikka API
APP_ENV=development
API_PREFIX=/api/v1

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337

ACCESS_MANAGER_ADDRESS=
PRIVATE_USD_ADDRESS=
BANK_REGISTRY_ADDRESS=
PAYMENT_PROCESSOR_ADDRESS=
SETTLEMENT_ENGINE_ADDRESS=
GOVERNANCE_ADDRESS=

# LOCAL DEVELOPMENT ONLY.
# Never commit backend/.env or any private keys.

BANK_ADMIN_PRIVATE_KEY=
MINTER_PRIVATE_KEY=
BURNER_PRIVATE_KEY=
FREEZER_PRIVATE_KEY=
PAUSER_PRIVATE_KEY=
SETTLEMENT_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://blocksikka:CHANGE_ME@127.0.0.1:5432/blocksikka
INDEXER_START_BLOCK=0
INDEXER_BATCH_SIZE=500
INDEXER_CONFIRMATIONS=0
INDEXER_POLL_SECONDS=2

# --------------------------------------------------
# API authentication / RBAC
# --------------------------------------------------
# Development-only static Bearer-token model.
# Real deployments should use an institutional
# identity/session system and managed secrets.
BLOCKSIKKA_AUTH_REQUIRED=true

BLOCKSIKKA_AUTH_VIEWER_TOKEN=replace-with-viewer-token
BLOCKSIKKA_AUTH_PAYMENT_OPERATOR_TOKEN=replace-with-payment-operator-token
BLOCKSIKKA_AUTH_BANK_OPERATOR_TOKEN=replace-with-bank-operator-token
BLOCKSIKKA_AUTH_TREASURY_OPERATOR_TOKEN=replace-with-treasury-operator-token
BLOCKSIKKA_AUTH_TREASURY_ADMIN_TOKEN=replace-with-treasury-admin-token

# Portfolio/public-demo safety mode.
# When true, every API POST/PUT/PATCH/DELETE is rejected
# before application business logic runs.
BLOCKSIKKA_PUBLIC_READ_ONLY=false
